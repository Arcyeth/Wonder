# ─── Wonder · Phase 1 (read-only screening) ───────────────────────────
# Copy to .env and fill in. Phase 1 needs NO private key (no transactions).

# Monad mainnet RPC (chainId 143). Public options:
#   https://rpc.monad.xyz        (QuickNode, ~25 rps)
#   https://rpc2.monad.xyz       (Goldsky,  300/10s)
#   https://rpc3.monad.xyz       (Ankr,     300/10s)
RPC_URL=https://rpc.monad.xyz

# GoPlus token-security chain id. Monad mainnet = 143 (testnet = 10143).
# If GoPlus has not indexed Monad under 143, security enrichment is skipped gracefully.
GOPLUS_CHAIN_ID=143

# Optional GoPlus app credentials for higher rate limits (not required for Phase 1).
# GOPLUS_APP_KEY=
# GOPLUS_APP_SECRET=

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ─── Phase 2 — position lifecycle (only needed to BROADCAST) ──────────
# WALLET_PRIVATE_KEY=        # EVM hex key (0x...) — only when DRY_RUN=false
# DRY_RUN=true               # default true: build & validate txs but never send

# ─── Phase 3b — LLM agent (OpenAI-compatible; needed for `agent`) ─────
# Default endpoint is OpenRouter. For a local model, point LLM_BASE_URL at it.
# LLM_BASE_URL=https://openrouter.ai/api/v1     # or http://localhost:1234/v1 (LM Studio)
# LLM_API_KEY=                                  # or OPENROUTER_API_KEY=
# LLM_MODEL=openai/gpt-4o-mini

# ─── Phase 4 — Telegram (later) ──────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
